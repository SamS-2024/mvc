{% extends "proj-base.html.twig" %}

{% block body %}

<h1 class="proj-h1">Sökning av förnybar energi per år och typ</h1>
<p>
    Vänligen välj ett år och en energityp för att visa energiproduktion i terawattimmar (TWh).
    Klicka på 'Filtrera' för att hämta uppdaterad data från databasen.
</p>

<form id="filter-form" class="search-form">
  <select id="year-input" class="year-input" required>
    <option value="">Välj år</option>
    <option value="2005">2005</option>
    <option value="2006">2006</option>
    <option value="2007">2007</option>
    <option value="2008">2008</option>
    <option value="2009">2009</option>
    <option value="2010">2010</option>
    <option value="2011">2011</option>
    <option value="2012">2012</option>
    <option value="2013">2013</option>
    <option value="2014">2014</option>
    <option value="2015">2015</option>
    <option value="2016">2016</option>
    <option value="2017">2017</option>
  </select>

  <select id="type-input" required>
    <option value="">Välj energityp</option>
    <option value="bio">Bio</option>
    <option value="hydro">Hydro</option>
    <option value="wind">Vind</option>
    <option value="heat">Värme</option>
    <option value="solar">Sol</option>
  </select>
  <button type="submit">Filtrera</button>
</form>

<div id="result" class="search-result hidden"></div>


{% endblock %}