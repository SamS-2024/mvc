<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/glider.svg') }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('project') }}
        {% endblock %}

    </head>
    <body>
        <nav>
            <ul>
                <li><a href="{{ path('about_proj') }}">Om</a></li>
                <li><a href="{{ path('proj') }}">Förnybar energi</a></li>
                <li><a href="{{ path('proj_energy') }}">Energi i TWh</a></li>
                <li><a href="{{ path('api-proj') }}">Api</a></li>
                <li><a href="{{ path('search_proj') }}">Sök</a></li>
            </ul>
        </nav>
        <header class="hero-header">
            <img src="{{ asset('img/heart.webp') }}" alt="Hållbarhet" class="hero-img">
        </header>

        <main>
            {% block body %}
            {% endblock %}
        </main>
        <footer class="footer">
            <div class="copyright">
                &copy; MVC 2025
            </div>

            <a href="https://github.com/SamS-2024/mvc" target="_blank">
                <img src="{{ asset('img/github-mark.png') }}" alt="GitHub" class="github-icon-proj" width="35">
            </a>
        </footer>
            {% block javascripts %}
                {{ encore_entry_script_tags('project') }}
            {% endblock %}

    </body>
</html>
